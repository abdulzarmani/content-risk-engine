# Safety Kit Configuration

# API Settings
FLASK_ENV=production
FLASK_DEBUG=0
API_PORT=5000
API_HOST=0.0.0.0

# Crisis Handling
CRISIS_ENABLED=true
LOG_INCIDENTS=true
SEND_EMAIL_ALERTS=true
SEND_SMS_ALERTS=false
SEND_WEBHOOK_ALERTS=false

# Guardian Emails (comma-separated)
GUARDIAN_EMAILS=parent@example.com,guardian@example.com

# Admin Email
ADMIN_EMAIL=admin@safetykitapp.com

# Restricted Mode
RESTRICTED_MODE_ENABLED=true